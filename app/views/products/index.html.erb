<h1>商品一覧</h1>
<p><%= link_to "新規商品登録", new_product_path %></p>
<p><%= link_to "カートを見る", cart_path(current_cart) %></p>

<hr>

<% @products.each do |product| %>
  <div style="border-bottom: 1px solid #ccc; padding: 10px 0;">
    <p><strong>商品名:</strong> <%= product.name %></p>
    <p><strong>価格:</strong> <%= product.price %> 円</p>
    <p>
      <%= link_to "カートに追加", new_cart_item_path(product_id: product.id) %> | 
      <%= button_to "商品削除", product_path(product), method: :delete %>
    </p>
  </div>
<% end %>