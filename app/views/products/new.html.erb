<h1>商品新規登録</h1>

<%= form_with(model: @product, local: true) do |f| %>
  <div>
    <%= f.label :name, "商品名" %><br>
    <%= f.text_field :name %>
  </div>
  <br>
  <div>
    <%= f.label :price, "価格" %><br>
    <%= f.number_field :price %>
  </div>
  <br>
  <div>
    <%= f.submit "登録する" %>
  </div>
<% end %>

<br>
<%= link_to "商品一覧へ戻る", products_path %>